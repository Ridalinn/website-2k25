# Fulcrum Technologies Website - Environment Variables
# Copy this file to .env.local and fill in the values

# BaseHub CMS (required for 3D scene assets)
# Get your token from https://basehub.com
BASEHUB_TOKEN=

# Supabase (used for basketball scoreboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_ENABLED=false

# Resend (email sending for contact form)
RESEND_API_KEY=

# Mailchimp (newsletter subscriptions)
MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_LIST_ID=

# AEGIS API (placeholder - for future backend integration)
# AEGIS_API_URL=https://api.fulcrumtech.ai/aegis/audit
# AEGIS_API_KEY=
